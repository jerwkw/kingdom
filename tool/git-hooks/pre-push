#!/usr/bin/env bash
# Runs tool/check.sh before pushing branches. Enable once per clone with
#   git config core.hooksPath tool/git-hooks
# Pushes of only tags (the tagged commit already passed on main) or the
# docs-only `documentation` branch skip it.
# Bypass in an emergency with git push --no-verify; CI still blocks the PR.
set -euo pipefail

branch_push=0
while read -r local_ref _ _ _; do
  case "$local_ref" in
    refs/tags/* | refs/heads/documentation | "(delete)") ;;
    *) branch_push=1 ;;
  esac
done

[[ "$branch_push" == 1 ]] || exit 0
exec "$(git rev-parse --show-toplevel)/tool/check.sh"
