{
  "name": "functions",
  "description": "Kingdom Firebase Cloud Functions",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test test/domain.test.js",
    "test:rules": "firebase emulators:exec --config ../firebase.json --project demo-kingdom --only firestore \"node --test test/firestore.rules.test.js\"",
    "test:integration": "firebase emulators:exec --config ../firebase.json --project demo-kingdom --only auth,firestore,functions \"node --test --test-concurrency=1 test/api.integration.test.js\""
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^15.29.0"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "private": true
}
