rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function sameBuilding(buildingId) {
      return signedIn() && buildingId != null && currentUser().buildingId == buildingId;
    }

    function isBuildingMember(buildingId) {
      return signedIn() && request.auth.uid in
        get(/databases/$(database)/documents/buildings/$(buildingId)).data.memberIds;
    }

    function boundedString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    // Purchased cosmetics are equipped only through the /equipItem function,
    // which verifies ownership. Clients may change the drawn avatar parts.
    function premiumSlotsUnchanged(next, prev) {
      return next.get('headpiece', null) == prev.get('headpiece', null)
        && next.get('shirt', null) == prev.get('shirt', null)
        && next.get('pants', null) == prev.get('pants', null)
        && next.get('companion', null) == prev.get('companion', null);
    }

    function validAvatarConfig(config) {
      return config is map && config.size() <= 20;
    }

    // Profiles are visible only to the owner and members of the same building.
    // Economy and membership fields are controlled by Cloud Functions.
    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId || sameBuilding(resource.data.buildingId)
      );
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.fishBalance == 10
        && request.resource.data.buildingId == null
        && request.resource.data.keys().hasOnly([
          'name', 'avatarConfig', 'buildingId', 'fishBalance', 'createdAt'
        ])
        && boundedString(request.resource.data.name, 40)
        && request.resource.data.name.size() > 0
        && validAvatarConfig(request.resource.data.avatarConfig)
        && premiumSlotsUnchanged(request.resource.data.avatarConfig, {});
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'avatarConfig'])
        && boundedString(request.resource.data.name, 40)
        && request.resource.data.name.size() > 0
        && validAvatarConfig(request.resource.data.avatarConfig)
        && premiumSlotsUnchanged(
          request.resource.data.avatarConfig, resource.data.get('avatarConfig', {}));
      allow delete: if false;
    }

    // Goals collection: ABSOLUTELY PRIVATE.
    // Only the goal owner can read or write their own goals.
    match /goals/{goalId} {
      function validGoalContent(data) {
        return boundedString(data.get('task', ''), 80)
          && boundedString(data.get('text', ''), 280)
          && data.get('frequency', 'daily') in ['daily', 'weekly', 'monthly']
          && data.get('archived', false) is bool
          && data.get('sharedToBulletin', false) is bool;
      }

      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.currentStreak == 0
        && request.resource.data.keys().hasOnly([
          'userId', 'type', 'task', 'text', 'frequency', 'currentStreak',
          'sharedToBulletin', 'archived', 'createdAt'
        ])
        && request.resource.data.type in ['smart', 'templated']
        && validGoalContent(request.resource.data);
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['task', 'text', 'frequency', 'sharedToBulletin', 'archived'])
        && validGoalContent(request.resource.data);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Completions collection:
    // Only server (Admin SDK) creates/updates completions. Clients cannot write.
    // Client can only read their own completion records.
    match /completions/{completionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Buildings collection:
    // Read allowed for members of the building. Direct client writes denied.
    match /buildings/{buildingId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow write: if false; // Membership and funds are written by Cloud Functions

      // Server-written fund contributions and achievement unlock history.
      match /fundLedger/{entryId} {
        allow read: if isBuildingMember(buildingId);
        allow write: if false;
      }
      match /achievements/{achievementId} {
        allow read: if isBuildingMember(buildingId);
        allow write: if false;
      }
    }

    // Bulletin Posts: readable by members of the post's building. Posts are
    // created by the /createBulletinPost function (rate limited); authors may
    // edit their text or delete; members may set or clear only their own
    // reaction.
    match /bulletinPosts/{postId} {
      allow read: if sameBuilding(resource.data.buildingId);
      allow create: if false;
      allow update: if signedIn() && sameBuilding(resource.data.buildingId) && (
        (resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt']) &&
          boundedString(request.resource.data.text, 1000) &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.get('editedAt', null) == request.time) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
          request.resource.data.reactions is map &&
          request.resource.data.reactions.diff(resource.data.get('reactions', {}))
            .affectedKeys().hasOnly([request.auth.uid]) &&
          (!(request.auth.uid in request.resource.data.reactions) ||
            request.resource.data.reactions[request.auth.uid] in ['❤️', '🙏', '🙌', '💡']))
      );
      allow delete: if signedIn() && resource.data.userId == request.auth.uid
        && sameBuilding(resource.data.buildingId);
    }

    // Notifications are written by Cloud Functions; recipients may only mark
    // their own as read.
    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow update: if signedIn() && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time;
      allow create, delete: if false;
    }

    // Store Items & Daily Challenges:
    // Read-only for authenticated users, writable only by server.
    match /storeItems/{itemId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /dailyChallenges/{date} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /inventory/{userId}/items/{itemId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // Server-only bookkeeping.
    match /memberActivity/{userId} {
      allow read, write: if false;
    }
    match /rateLimits/{limitId} {
      allow read, write: if false;
    }
    match /inviteCodes/{code} {
      allow read, write: if false;
    }
  }
}
